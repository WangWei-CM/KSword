  <!-- Taskbar 使用 Qt Multimedia 播放可选地震 WAV；Release 输出必须随程序部署对应 DLL 和媒体插件。 -->
  <Target Name="DeployTaskbarQtRuntime" AfterTargets="Build" Condition="'$(Configuration)|$(Platform)'=='Release|x64' and Exists('$(TargetPath)')">
    <PropertyGroup>
      <TaskbarQtDeployExe Condition="'$(TaskbarQtDeployExe)'=='' and '$(KSWORD_QT_DIR)'!='' and Exists('$(KSWORD_QT_DIR)\bin\windeployqt.exe')">$(KSWORD_QT_DIR)\bin\windeployqt.exe</TaskbarQtDeployExe>
      <TaskbarQtDeployExe Condition="'$(TaskbarQtDeployExe)'=='' and Exists('$(MSBuildProjectDirectory)\..\.deps\Qt\6.9.3\msvc2022_64\bin\windeployqt.exe')">$(MSBuildProjectDirectory)\..\.deps\Qt\6.9.3\msvc2022_64\bin\windeployqt.exe</TaskbarQtDeployExe>
      <TaskbarQtDeployExe Condition="'$(TaskbarQtDeployExe)'=='' and '$(QtInstall)'!='' and Exists('$(QtInstall)\bin\windeployqt.exe')">$(QtInstall)\bin\windeployqt.exe</TaskbarQtDeployExe>
      <TaskbarQtDeployExe Condition="'$(TaskbarQtDeployExe)'=='' and '$(QTDIR)'!='' and Exists('$(QTDIR)\bin\windeployqt.exe')">$(QTDIR)\bin\windeployqt.exe</TaskbarQtDeployExe>
    </PropertyGroup>
    <Message Importance="High" Text="Taskbar: deploying Qt runtime and multimedia plugins to $(TargetDir)" Condition="Exists('$(TaskbarQtDeployExe)')" />
    <!-- 增量部署保留相同且可能被占用的 Qt DLL，并明确提供 VC 运行库定位环境。 -->
    <Exec Command="&quot;$(TaskbarQtDeployExe)&quot; --release --compiler-runtime --dir &quot;$(TargetDir).&quot; &quot;$(TargetPath)&quot;" EnvironmentVariables="VCINSTALLDIR=$(VCInstallDir)" Condition="Exists('$(TaskbarQtDeployExe)')" />
    <Warning Condition="!Exists('$(TaskbarQtDeployExe)')" Text="Taskbar: windeployqt.exe was not found; Release output may be missing Qt Multimedia runtime files." />
  </Target>
</Project>
