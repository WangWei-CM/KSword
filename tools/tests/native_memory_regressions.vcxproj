  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="ValidateNativeRegressionInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Fixture)' != 'Catalog' and '$(Fixture)' != 'Target' and '$(Fixture)' != 'Codec' and '$(Fixture)' != 'Threads' and '$(Fixture)' != 'ProtectionResults' and '$(Fixture)' != 'AuditEvidence'" Text="Fixture must be Catalog, Target, Codec, Threads, ProtectionResults, or AuditEvidence." />
    <Error Condition="!Exists('$(OutDir)')" Text="The existing repository output directory is required." />
    <Error Condition="!Exists('$(CLToolPath)cl.exe') or !Exists('$(LinkToolPath)link.exe')" Text="HostX64 MSVC is required." />
    <Error Condition="'$(Fixture)' == 'Codec' and !Exists('$(KSWORD_QT_DIR)\lib\Qt6Core.lib')" Text="KSWORD_QT_DIR must identify an MSVC Qt SDK." />
