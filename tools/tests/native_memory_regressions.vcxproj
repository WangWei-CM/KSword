  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- 只使用既有 output 目录；三个入口分别生成二进制，不进入产品工程。 -->
    <OutDir>$(MSBuildThisFileDirectory)..\..\output\</OutDir>
    <IntDir>$(OutDir)</IntDir>
    <TLogLocation>$(IntDir)</TLogLocation>
    <TrackFileAccess>false</TrackFileAccess>
    <EnableManagedMinimalRebuild>false</EnableManagedMinimalRebuild>
    <TargetName Condition="'$(Fixture)' == 'Catalog'">memory_debug_process_catalog_tests</TargetName>
    <TargetName Condition="'$(Fixture)' == 'Target'">issue216_r3_target</TargetName>
    <TargetName Condition="'$(Fixture)' == 'Codec'">code_editor_file_decode_tests</TargetName>
    <TargetName Condition="'$(Fixture)' == 'Threads'">memory_debug_thread_session_tests</TargetName>
    <TargetName Condition="'$(Fixture)' == 'ProtectionResults'">memory_result_reporting_tests</TargetName>
    <TargetName Condition="'$(Fixture)' == 'AuditEvidence'">kernel_service_audit_evidence_tests</TargetName>
    <CLToolPath>$(VCToolsInstallDir)bin\Hostx64\x64\</CLToolPath>
    <LinkToolPath>$(VCToolsInstallDir)bin\Hostx64\x64\</LinkToolPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NOMINMAX;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DebugInformationFormat>None</DebugInformationFormat>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /permissive- %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <LinkIncremental>false</LinkIncremental>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Fixture)' == 'Codec'">
    <ClCompile>
      <PreprocessorDefinitions>QT_CORE_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <AdditionalOptions>/external:I"$(KSWORD_QT_DIR)\include" /external:I"$(KSWORD_QT_DIR)\include\QtCore" %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(KSWORD_QT_DIR)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>Qt6Core.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="kernel_service_audit_evidence_tests.cpp">
      <ExcludedFromBuild Condition="'$(Fixture)' != 'AuditEvidence'">true</ExcludedFromBuild>
