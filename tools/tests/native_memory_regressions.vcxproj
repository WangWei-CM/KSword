    <ClCompile Include="..\..\Ksword5.1\Ksword5.1\MemoryDock\MemoryDebugProcessCatalog.cpp">
      <ExcludedFromBuild Condition="'$(Fixture)' != 'Catalog'">true</ExcludedFromBuild>
